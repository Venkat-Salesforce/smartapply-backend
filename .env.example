# ─────────────────────────────────────────────
# SmartApply — Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to GitHub
# ─────────────────────────────────────────────

# Your Gmail address (the one that SENDS the emails)
GMAIL_USER=venkataramanabommedi@gmail.com

# Gmail App Password (NOT your regular Gmail password)
# How to get it:
#   1. Go to myaccount.google.com
#   2. Security → 2-Step Verification (enable if not already)
#   3. Security → App passwords
#   4. Select app: Mail, Select device: Other → type "SmartApply"
#   5. Copy the 16-character password → paste here (no spaces)
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Email that receives the confirmations (your inbox)
NOTIFY_EMAIL=venkataramanabommedi@gmail.com

# Optional: CC a second email on every confirmation
CC_EMAIL=

# Server port (Railway sets this automatically)
PORT=3000

# Optional: Anthropic API key for AI job matching
ANTHROPIC_API_KEY=your_anthropic_api_key_here
